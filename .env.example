# Copy to .env.local and fill in. Nothing here is required: with every provider off, Heard still records,
# stores, summarizes (template), and shares. AI and live captions light up when configured.

# ---------- AI: OpenAI GPT-5.6 on Amazon Bedrock (the event setup) ----------
HEARD_AI_PROVIDER=bedrock
HEARD_BEDROCK_REGION=us-east-1
# runtime = bedrock-runtime.<region>.amazonaws.com/openai/v1 (global./us. profile ids); mantle = bedrock-mantle.<region>.api.aws
HEARD_BEDROCK_ENDPOINT=runtime
HEARD_MODEL_SMART=global.openai.gpt-5.6-terra
HEARD_MODEL_FAST=global.openai.gpt-5.6-luna
# Credentials: the standard AWS chain. Paste Workshop Studio's "Get AWS CLI credentials" exports, e.g.
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...
# AWS_SESSION_TOKEN=...
# …or use a Bedrock bearer token instead of SigV4:
# AWS_BEARER_TOKEN_BEDROCK=bedrock-api-key-...

# ---------- AI alternative: any OpenAI-compatible endpoint (development) ----------
# HEARD_AI_PROVIDER=openai
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_API_KEY=...
# HEARD_OPENAI_WIRE=chat            # chat | responses
# HEARD_MODEL_SMART=openai/gpt-5.6-terra
# HEARD_MODEL_FAST=openai/gpt-5.6-luna

# ---------- Speech: Amazon Transcribe streaming (live captions + word timings) ----------
HEARD_STT_PROVIDER=aws-transcribe
HEARD_TRANSCRIBE_REGION=us-east-1

# ---------- Security ----------
# 32 random bytes, base64. If unset, a key is generated into .data/master.key for local use.
# openssl rand -base64 32
# HEARD_MASTER_KEY=
# Set to 1 when served over HTTPS so cookies are Secure.
# HEARD_SECURE_COOKIES=1

# ---------- Live conversation with Linh (LiveKit agent + Tavus avatar) ----------
# LIVEKIT_URL=wss://<project>.livekit.cloud
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=
# TAVUS_API_KEY=
# TAVUS_PAL_ID=            # an echo-mode PAL (pipeline_mode "echo", LiveKit transport)
# TAVUS_FACE_ID=r90e7a409fac   # "Dawn - Casual" (phoenix-4.5), an older woman
# NEXT_PUBLIC_HEARD_PORTRAIT=/linh-v2.jpg   # still shown until the avatar video arrives; match it to the face (build time)
# HEARD_AGENT_VOICE=inworld/inworld-tts-2:Ashley
# HEARD_AGENT_LLM=openai/gpt-5.6-luna          # or bedrock:global.openai.gpt-5.6-luna
# HEARD_AGENT_BACKEND_URL=http://127.0.0.1:3120  # where the agent reaches this app

# ---------- Mobile app ----------
# The questions the mobile app asks, in order (comma-separated ids). Unset = every question.
# HEARD_MOBILE_FLOW=quality_of_life,ventilator   # the 2-question live demo

# ---------- Demo ----------
# Enables the demo persona loader and the time-travel / memorial tools.
HEARD_DEMO=1
